# Direction B, phase 1 -- compare label-free selectors at TEST time with fixed generators (no retraining).
# Selectors: random, first, dedup, pairable, typical, kcenter, camera_balanced, style_cover, hard_negative,
# facility, facility_camera (adapters/selectors.py). Small targets VIPeR / GRID / i-LIDS, 3 splits.
# Needs: stage 1 (VPT reference, $LOSS_REF) and plans/dirA.tasks (a0_vicp, $A_BEST_RUN).
#
# (1) tuned generator: VPT prompt tuned on the k annotated pairs (lr 3e-4, 300 steps) -- known to be
#     selection-sensitive. One task per domain (~2-3 h each on one GPU).
sel_tuned_viper | selsweep sel_tuned_viper experiments/${LOSS_REF:-s1_vpt_bot}/checkpoint-3000 tuned --domains viper --eval_splits 3 --ks 4,16 --n_draws 3 --random_draws 10 --fp16 False
sel_tuned_grid  | selsweep sel_tuned_grid  experiments/${LOSS_REF:-s1_vpt_bot}/checkpoint-3000 tuned --domains grid  --eval_splits 3 --ks 4,16 --n_draws 3 --random_draws 10 --fp16 False
sel_tuned_ilids | selsweep sel_tuned_ilids experiments/${LOSS_REF:-s1_vpt_bot}/checkpoint-3000 tuned --domains ilids --eval_splits 3 --ks 4,16 --n_draws 3 --random_draws 10 --fp16 False
# (2) in-context generators (no gradients, ~1-1.5 h each): original VICP* (control: expected insensitive)
#     and the best direction-A model
sel_ic_vicp     | selsweep sel_ic_vicp     experiments/a0_vicp/checkpoint-3000            incontext --domains viper,grid,ilids --eval_splits 3 --ks 4,8,16 --n_draws 5 --random_draws 10 --fp16 True
sel_ic_abest    | selsweep sel_ic_abest    experiments/${A_BEST_RUN}/checkpoint-3000      incontext --domains viper,grid,ilids --eval_splits 3 --ks 4,8,16 --n_draws 5 --random_draws 10 --fp16 True
