# 10-06 evening backlog (DINOv2 base models unless noted): one pool over all GPUs, filled in this order as GPUs free up.
# VLM = Qwen3-VL-8B with the LoRA of the target's own fold (sources only); "file" = machine answers, log-odds > 2.2 / < -2.2.
# --- CUHK03: question set of every cluster (K=3), scored by its fold's LoRA, then 3 seeds end-to-end
b_qall_cuhk03 | while ! grep -q "^saved" experiments/vlm_train_cuhk03/finetune.log 2>/dev/null; do sleep 60; done; gpu_wait && $PY scripts/make_vlm_pairs.py --output_dir experiments/vlm_qall_cuhk03 --checkpoint $(ckpt base_md_cuhk03) --domains cuhk03 --all_k 3 --n_hard 50 --fp16 True --report_to none --eval_num_workers 8 && $PY scripts/diag_vlm.py --pairs experiments/vlm_qall_cuhk03/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-8B-Instruct --adapter experiments/vlm_train_cuhk03/lora --out experiments/vlm_qall_cuhk03/answers_lora.csv
b_file_cuhk03 after=b_qall_cuhk03 | gpu_wait && active b_file_cuhk03 $(ckpt base_md_cuhk03) --domains cuhk03 --strategies file --n_seeds 3 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_cuhk03/answers_lora.csv --answer_yes 2.2 --answer_no -2.2 --strategy_suffix @t2.2
# --- MSMT17: second seed of the main machine-answer run
b_file_t22_msmt_s1 | gpu_wait && active b_file_t22_msmt_s1 $(ckpt base_md_msmt17) --domains msmt17 --strategies file --n_seeds 1 --base_seed 1 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --answer_yes 2.2 --answer_no -2.2 --strategy_suffix @t2.2
# --- MSMT17: is the source fine-tuning needed? zero-shot answers on the same questions
b_qall_msmt_zs | gpu_wait && $PY scripts/diag_vlm.py --pairs experiments/vlm_qall_msmt/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-8B-Instruct --out experiments/vlm_qall_msmt/answers_zs.csv
b_file_zs_msmt after=b_qall_msmt_zs | gpu_wait && active b_file_zs_msmt $(ckpt base_md_msmt17) --domains msmt17 --strategies file --n_seeds 1 --base_seed 0 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_zs.csv --answer_yes 2.2 --answer_no -2.2 --strategy_suffix @zs_t2.2
# --- MSMT17: more questions per cluster (K=5)
b_qall_msmt_k5 | gpu_wait && $PY scripts/make_vlm_pairs.py --output_dir experiments/vlm_qall_msmt_k5 --checkpoint $(ckpt base_md_msmt17) --domains msmt17 --all_k 5 --n_hard 50 --fp16 True --report_to none --eval_num_workers 8 && $PY scripts/diag_vlm.py --pairs experiments/vlm_qall_msmt_k5/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-8B-Instruct --adapter experiments/vlm_train_msmt/lora --out experiments/vlm_qall_msmt_k5/answers_lora.csv
b_file_k5_msmt after=b_qall_msmt_k5 | gpu_wait && active b_file_k5_msmt $(ckpt base_md_msmt17) --domains msmt17 --strategies file --n_seeds 1 --base_seed 0 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt_k5/answers_lora.csv --answer_yes 2.2 --answer_no -2.2 --strategy_suffix @k5_t2.2
# --- Market: the whole VLM pipeline for its fold (sources MSMT17, CUHK03, CUHK-SYSU)
b_vlm_market | gpu_wait && $PY scripts/make_vlm_source_pairs.py --output_dir experiments/vlm_train_market --checkpoint $(ckpt base_md_market1501) --domains msmt17,cuhk03,cuhksysu --fp16 True --report_to none --eval_num_workers 8 && $PY scripts/finetune_vlm.py --pairs experiments/vlm_train_market/train_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-8B-Instruct --out experiments/vlm_train_market/lora && $PY scripts/make_vlm_pairs.py --output_dir experiments/vlm_qall_market --checkpoint $(ckpt base_md_market1501) --domains market1501 --all_k 3 --n_hard 250 --fp16 True --report_to none --eval_num_workers 8 && $PY scripts/diag_vlm.py --pairs experiments/vlm_qall_market/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-8B-Instruct --adapter experiments/vlm_train_market/lora --out experiments/vlm_qall_market/answers_lora.csv
b_file_market after=b_vlm_market | gpu_wait && active b_file_market $(ckpt base_md_market1501) --domains market1501 --strategies file --n_seeds 2 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_market/answers_lora.csv --answer_yes 2.2 --answer_no -2.2 --strategy_suffix @t2.2
# --- CLIP Market fold at lr 2e-4 (completes the CLIP table)
b_clip2_market | gpu_wait && train clip2_md_market1501 $STEPS $MD $CLIP $(fold market1501) $LOSS_ARGS $SCHEDULE --learning_rate 2e-4
b_clip2_market_none after=b_clip2_market | gpu_wait && active c62_none_market_s0 $(ckpt clip2_md_market1501) --domains market1501 --strategies none --n_seeds 1 --base_seed 0 $REP
