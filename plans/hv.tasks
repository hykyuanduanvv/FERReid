# 10-06 night: VLM-assisted active learning. The VLM answers every question (round 1); a human checks the VLM's most
# confident "same" candidates (--human_verify N, simulated annotator); "different" answers stay machine answers.
hv_all_msmt      | gpu_wait && active hv_all_msmt      $(ckpt base_md_msmt17) --domains msmt17 --n_seeds 1 --base_seed 0 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answer_yes 2.2 --answer_no -2.2 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --human_verify 100000 --strategy_suffix @hv_all
hv250_drop_msmt  | gpu_wait && active hv250_drop_msmt  $(ckpt base_md_msmt17) --domains msmt17 --n_seeds 1 --base_seed 0 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answer_yes 2.2 --answer_no -2.2 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --human_verify 250 --unverified_yes drop --strategy_suffix @hv250_drop
hv250_trust_msmt | gpu_wait && active hv250_trust_msmt $(ckpt base_md_msmt17) --domains msmt17 --n_seeds 1 --base_seed 0 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answer_yes 2.2 --answer_no -2.2 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --human_verify 250 --unverified_yes trust --strategy_suffix @hv250_trust
hv100_drop_msmt  | gpu_wait && active hv100_drop_msmt  $(ckpt base_md_msmt17) --domains msmt17 --n_seeds 1 --base_seed 0 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answer_yes 2.2 --answer_no -2.2 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --human_verify 100 --unverified_yes drop --strategy_suffix @hv100_drop
hv_all_k5_msmt   | gpu_wait && active hv_all_k5_msmt   $(ckpt base_md_msmt17) --domains msmt17 --n_seeds 1 --base_seed 0 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answer_yes 2.2 --answer_no -2.2 --answers_file experiments/vlm_qall_msmt_k5/answers_lora.csv --human_verify 100000 --strategy_suffix @k5_hv_all
hv_all_cuhk03    | gpu_wait && active hv_all_cuhk03    $(ckpt base_md_cuhk03) --domains cuhk03 --n_seeds 3 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answer_yes 2.2 --answer_no -2.2 --answers_file experiments/vlm_qall_cuhk03/answers_lora.csv --human_verify 100000 --strategy_suffix @hv_all
hv_all_market    | gpu_wait && active hv_all_market    $(ckpt base_md_market1501) --domains market1501 --n_seeds 2 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answer_yes 2.2 --answer_no -2.2 --answers_file experiments/vlm_qall_market/answers_lora.csv --human_verify 100000 --strategy_suffix @hv_all
hv_all_nono_market | gpu_wait && active hv_all_nono_market $(ckpt base_md_market1501) --domains market1501 --n_seeds 2 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answer_yes 2.2 --answer_no=-1e9 --answers_file experiments/vlm_qall_market/answers_lora.csv --human_verify 100000 --strategy_suffix @hv_all_nono
