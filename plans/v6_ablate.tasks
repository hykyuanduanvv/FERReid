v6_yesonly_msmt | while [ ! -s experiments/vlm_qall_msmt/answers_lora.csv ]; do sleep 30; done; gpu_wait && active v6_yesonly_msmt $(ckpt base_md_msmt17) --domains msmt17 --strategies file --n_seeds 1 --base_seed 0 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --answer_yes 2.2 --answer_no -1e9 --strategy_suffix @yesonly
v6_noonly_msmt | while [ ! -s experiments/vlm_qall_msmt/answers_lora.csv ]; do sleep 30; done; gpu_wait && active v6_noonly_msmt $(ckpt base_md_msmt17) --domains msmt17 --strategies file --n_seeds 1 --base_seed 0 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --answer_yes 1e9 --answer_no -2.2 --strategy_suffix @noonly
