# 10-06 night: VLM size ablation (Qwen3-VL 2B / 4B vs 8B), same MSMT17-fold source pairs and recipe; offline + end-to-end (seed 0)
vs_2b | while pgrep -f "[h]uggingface-cli download Qwen/Qwen3-VL-2B" >/dev/null; do sleep 60; done; gpu_wait && $PY scripts/finetune_vlm.py --pairs experiments/vlm_train_msmt/train_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-2B-Instruct --out experiments/vlm_train_msmt/lora_2b && $PY scripts/diag_vlm.py --pairs experiments/vlm_pairs_msmt/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-2B-Instruct --adapter experiments/vlm_train_msmt/lora_2b --out experiments/vlm_pairs_msmt/vlm_qwen3vl2b_lora.csv && $PY scripts/diag_vlm.py --pairs experiments/vlm_qall_msmt/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-2B-Instruct --adapter experiments/vlm_train_msmt/lora_2b --out experiments/vlm_qall_msmt/answers_lora_2b.csv && active vs_2b_file_msmt $(ckpt base_md_msmt17) --domains msmt17 --n_seeds 1 --base_seed 0 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_lora_2b.csv --answer_yes 2.2 --answer_no -2.2 --strategy_suffix @2b_t2.2
vs_4b | while pgrep -f "[h]uggingface-cli download Qwen/Qwen3-VL-4B" >/dev/null; do sleep 60; done; gpu_wait && $PY scripts/finetune_vlm.py --pairs experiments/vlm_train_msmt/train_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-4B-Instruct --out experiments/vlm_train_msmt/lora_4b && $PY scripts/diag_vlm.py --pairs experiments/vlm_pairs_msmt/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-4B-Instruct --adapter experiments/vlm_train_msmt/lora_4b --out experiments/vlm_pairs_msmt/vlm_qwen3vl4b_lora.csv && $PY scripts/diag_vlm.py --pairs experiments/vlm_qall_msmt/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-4B-Instruct --adapter experiments/vlm_train_msmt/lora_4b --out experiments/vlm_qall_msmt/answers_lora_4b.csv && active vs_4b_file_msmt $(ckpt base_md_msmt17) --domains msmt17 --n_seeds 1 --base_seed 0 $REP --strategies file --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_lora_4b.csv --answer_yes 2.2 --answer_no -2.2 --strategy_suffix @4b_t2.2
