# 10-06 night: plug-in line. PASS (ECCV22) UDA Market -> MSMT17 with its own code (Cluster Contrast, ViT-S LUPerson,
# Market-supervised source model), reproduced as is, then + VLM must/cannot-links (VLM LoRA trained on Market only).
u_dump_m2ms | gpu_wait && cd /data1/yangbin/dz/external/PASS-reID/PASS_cluster_contrast_reid && PYTHONPATH=. $PY examples/cluster_contrast_train_usl.py -b 256 -a vit_small -d msmt17 --data-dir /data1/yangbin/dz/pass-data --iters 200 --eps 0.7 --self-norm --use-hard --hw-ratio 2 --num-instances 8 -pp /data1/yangbin/dz/weights/pass_vits_market_sup.pth --logs-dir /data1/yangbin/dz/experiments/FERReid_CR_experiments/u_dump_m2ms --feat-fusion mean --multi-neck --dump-epoch0 /data1/yangbin/dz/experiments/FERReid_CR_experiments/u_dump_m2ms/epoch0.npz
u_questions_m2ms after=u_dump_m2ms | $PY scripts/pass_questions.py --dump experiments/u_dump_m2ms/epoch0.npz --out experiments/u_dump_m2ms/verify_pairs.csv --domain msmt17 --k 3
u_lora_market | gpu_wait && $PY scripts/make_vlm_source_pairs.py --output_dir experiments/vlm_train_marketonly --checkpoint $(ckpt base_md_msmt17) --domains market1501 --per_id 4 --fp16 True --report_to none --eval_num_workers 8 && $PY scripts/finetune_vlm.py --pairs experiments/vlm_train_marketonly/train_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-8B-Instruct --max_per_domain 12000 --out experiments/vlm_train_marketonly/lora
u_score_m2ms after=u_questions_m2ms,u_lora_market | gpu_wait && $PY scripts/diag_vlm.py --pairs experiments/u_dump_m2ms/verify_pairs.csv --model /data1/yangbin/dz/models/Qwen3-VL-8B-Instruct --adapter experiments/vlm_train_marketonly/lora --out experiments/u_dump_m2ms/answers_lora.csv
u_base_m2ms after=u_dump_m2ms | gpu_wait && cd /data1/yangbin/dz/external/PASS-reID/PASS_cluster_contrast_reid && PYTHONPATH=. $PY examples/cluster_contrast_train_usl.py -b 256 -a vit_small -d msmt17 --data-dir /data1/yangbin/dz/pass-data --iters 200 --eps 0.7 --self-norm --use-hard --hw-ratio 2 --num-instances 8 -pp /data1/yangbin/dz/weights/pass_vits_market_sup.pth --logs-dir /data1/yangbin/dz/experiments/FERReid_CR_experiments/u_base_m2ms --feat-fusion mean --multi-neck
u_vlm_m2ms after=u_score_m2ms | gpu_wait && cd /data1/yangbin/dz/external/PASS-reID/PASS_cluster_contrast_reid && PYTHONPATH=. $PY examples/cluster_contrast_train_usl.py -b 256 -a vit_small -d msmt17 --data-dir /data1/yangbin/dz/pass-data --iters 200 --eps 0.7 --self-norm --use-hard --hw-ratio 2 --num-instances 8 -pp /data1/yangbin/dz/weights/pass_vits_market_sup.pth --logs-dir /data1/yangbin/dz/experiments/FERReid_CR_experiments/u_vlm_m2ms --feat-fusion mean --multi-neck --answers /data1/yangbin/dz/experiments/FERReid_CR_experiments/u_dump_m2ms/answers_lora.csv
