# Single-fold pilot (CUHK03 target; sources Market + MSMT17 + CUHK-SYSU): does cluster repair beat random?
# ~3 h wall, ~6 GPU-h. Default hyper-parameters (no tuning runs): eps 0.6, 400 steps / round, lr 3e-4.
#   python scripts/launch_tasks.py plans/pilot.tasks --gpus 0,1,2,3,4
#
# 1. the fold's base model (VPT + multi-domain tokens), ~1.5 h on one GPU
base_md_cuhk03 | train base_md_cuhk03 $STEPS $MD $(fold cuhk03) $LOSS_ARGS $SCHEDULE
@wait
# 2. offline screening (~15 min): pseudo-label pairwise F1 after 5 x 200 answers per strategy -- read this first
sim_cuhk03 | sim sim_cuhk03 $(ckpt base_md_cuhk03) --domains cuhk03 --n_seeds 3 --strategies none,repair,repair_random,random,cover --pseudo True --rounds 5 --budget 200 --paired_ref random
# 3. training runs, one seed per GPU (~1 h each): none = unsupervised (0 answers), repair = ours,
#    repair_random / random = random references
pilot_s0 | active pilot_s0 $(ckpt base_md_cuhk03) --domains cuhk03 --strategies none,repair,repair_random,random --n_seeds 1 --base_seed 0 $REP
pilot_s1 | active pilot_s1 $(ckpt base_md_cuhk03) --domains cuhk03 --strategies none,repair,repair_random,random --n_seeds 1 --base_seed 1 $REP
pilot_s2 | active pilot_s2 $(ckpt base_md_cuhk03) --domains cuhk03 --strategies none,repair,repair_random,random --n_seeds 1 --base_seed 2 $REP
# the previous method (pair questions, no pseudo labels) on the same base, for reference
pilot_pair | active pilot_pair $(ckpt base_md_cuhk03) --domains cuhk03 --strategies cover,random --n_seeds 3 $ACT --oracle_all True
@wait
merge_pilot | $PY scripts/merge_active.py experiments/pilot_s0 experiments/pilot_s1 experiments/pilot_s2 --out experiments/pilot --paired_ref random
