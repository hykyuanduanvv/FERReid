# Six independent 100-step controls, then resume the FP32 run to 300 steps.
# Uses configs/local.sh and plans/common.sh. Existing successful task statuses are skipped.
probe_a0_control | A0_PROBE_VARIANT=control "$PY" scripts/diagnose_a0_train.py --output_dir experiments/probe_a0_control --max_steps 100 --save_steps 100 $TRAIN_COMMON --model_type vicp $TUNE_DATA --eval_steps 100
probe_a0_fp32_triplet | A0_PROBE_VARIANT=fp32_triplet "$PY" scripts/diagnose_a0_train.py --output_dir experiments/probe_a0_fp32_triplet --max_steps 100 --save_steps 100 $TRAIN_COMMON --model_type vicp $TUNE_DATA --eval_steps 100
probe_a0_noicl | A0_PROBE_VARIANT=noicl "$PY" scripts/diagnose_a0_train.py --output_dir experiments/probe_a0_noicl --max_steps 100 --save_steps 100 $TRAIN_COMMON --model_type vicp $TUNE_DATA --eval_steps 100 --icl_loss_weight 0
probe_a0_lr1e5 | A0_PROBE_VARIANT=lr1e5 "$PY" scripts/diagnose_a0_train.py --output_dir experiments/probe_a0_lr1e5 --max_steps 100 --save_steps 100 $TRAIN_COMMON --model_type vicp $TUNE_DATA --eval_steps 100 --learning_rate 1e-5
probe_a0_hidden_norm | A0_PROBE_VARIANT=hidden_norm "$PY" scripts/diagnose_a0_train.py --output_dir experiments/probe_a0_hidden_norm --max_steps 100 --save_steps 100 $TRAIN_COMMON --model_type vicp $TUNE_DATA --eval_steps 100
probe_a0_random_init | A0_PROBE_VARIANT=random_init "$PY" scripts/diagnose_a0_train.py --output_dir experiments/probe_a0_random_init --max_steps 100 --save_steps 100 $TRAIN_COMMON --model_type vicp $TUNE_DATA --eval_steps 100
@wait
probe_a0_fp32_300 | A0_PROBE_VARIANT=fp32_triplet A0_PROBE_STEP_OFFSET=100 "$PY" scripts/diagnose_a0_train.py --output_dir experiments/probe_a0_fp32_300 --resume_from_checkpoint experiments/probe_a0_fp32_triplet/checkpoint-100 --max_steps 300 --save_steps 300 $TRAIN_COMMON --model_type vicp $TUNE_DATA --eval_steps 100
