# Diagnostics (before the active runs): can each fold's base model propose useful cross-camera pairs?
# hit@k, mutual-NN precision, positive rate of proposed pairs, calibration, AUC; verify_pairs.csv for
# scripts/diag_vlm.py (MLLM vs ReID as a same-person verifier).
diag_market1501 | diag diag_market1501 $(ckpt base_md_market1501) --domains market1501
diag_msmt17     | diag diag_msmt17     $(ckpt base_md_msmt17)     --domains msmt17
diag_cuhk03     | diag diag_cuhk03     $(ckpt base_md_cuhk03)     --domains cuhk03
# MLLM verifier (needs the model weights, ~16 GB for 7B in bf16):
#   python scripts/diag_vlm.py --pairs experiments/diag_cuhk03/verify_pairs.csv --model Qwen/Qwen2.5-VL-7B-Instruct
