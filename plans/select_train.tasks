# Direction B, phase 2 -- train the generator with selector-chosen contexts (--train_context_selector),
# then test with the same selector: does using the selector at train AND test time add to test-time only?
# Base configuration: the best direction-A setting ($A_BEST_ARGS, includes the episodic split that the
# selector acts on). The random-context control is $A_BEST_RUN from plans/dirA.tasks (same config).
# Edit the selector list after phase 1 (best 1-3 selectors); camera-based selectors have no camera ids
# inside a batch (camera_balanced -> dedup, facility_camera -> facility), style_cover is unsupported.
# ~40 min per training; evaluation ~1 h each.
st_typical      | train st_typical      3000 --model_type vicp $TUNE_DATA $LOSS_ARGS $A_BEST_ARGS --train_context_selector typical
st_facility     | train st_facility     3000 --model_type vicp $TUNE_DATA $LOSS_ARGS $A_BEST_ARGS --train_context_selector facility
st_kcenter      | train st_kcenter      3000 --model_type vicp $TUNE_DATA $LOSS_ARGS $A_BEST_ARGS --train_context_selector kcenter
@wait
# test: the same selector as in training, and random, on the small targets (compare with sel_ic_abest)
ste_typical     | selsweep ste_typical  experiments/st_typical/checkpoint-3000  incontext --domains viper,grid,ilids --eval_splits 3 --ks 4,8,16 --n_draws 5 --random_draws 10 --fp16 True
ste_facility    | selsweep ste_facility experiments/st_facility/checkpoint-3000 incontext --domains viper,grid,ilids --eval_splits 3 --ks 4,8,16 --n_draws 5 --random_draws 10 --fp16 True
ste_kcenter     | selsweep ste_kcenter  experiments/st_kcenter/checkpoint-3000  incontext --domains viper,grid,ilids --eval_splits 3 --ks 4,8,16 --n_draws 5 --random_draws 10 --fp16 True
