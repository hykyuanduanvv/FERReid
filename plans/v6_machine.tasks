# 10-06: machine (fine-tuned Qwen3-VL-8B, MSMT17-fold source LoRA) answers every cluster vs its 3 nearest complementary
# clusters in round 1; only confident answers enter (log-odds > yes / < no). DINOv2 base, MSMT17, seed 0.
# References: none 51.1, human 250 (rule / random / repair2) 51.7-53.0, oracle 59.5.
v6_file_t22_msmt | while [ ! -s experiments/vlm_qall_msmt/answers_lora.csv ]; do sleep 30; done; gpu_wait && active v6_file_t22_msmt $(ckpt base_md_msmt17) --domains msmt17 --strategies file --n_seeds 1 --base_seed 0 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --answer_yes 2.2 --answer_no -2.2 --strategy_suffix @t2.2
v6_file_t46_msmt | while [ ! -s experiments/vlm_qall_msmt/answers_lora.csv ]; do sleep 30; done; gpu_wait && active v6_file_t46_msmt $(ckpt base_md_msmt17) --domains msmt17 --strategies file --n_seeds 1 --base_seed 0 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --answer_yes 4.6 --answer_no -4.6 --strategy_suffix @t4.6
v6_file_t0_msmt  | while [ ! -s experiments/vlm_qall_msmt/answers_lora.csv ]; do sleep 30; done; gpu_wait && active v6_file_t0_msmt  $(ckpt base_md_msmt17) --domains msmt17 --strategies file --n_seeds 1 --base_seed 0 $REP --budget_schedule 100000,0,0,0,0 --answers_file experiments/vlm_qall_msmt/answers_lora.csv --answer_yes 0 --answer_no 0 --strategy_suffix @t0
