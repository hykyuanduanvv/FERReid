d6_committee_market | gpu_wait && mkdir -p experiments/d6_committee_market && $PY scripts/diag_committee.py --output_dir experiments/d6_committee_market --checkpoint $(ckpt base_md_market1501) --domains market1501 --prompts experiments/fb_none_market1501/prompts/market1501_none_seed0.pt --fp16 True --report_to none --eval_num_workers 8
