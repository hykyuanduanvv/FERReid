# Stage 4b -- Protocol-3 runs: identical to plans/stage4_protocol2.tasks except that every source domain
# contributes ALL its images (train + query + gallery, torchreid combineall: --source_all_images True);
# the target side is unchanged (its train split = unlabeled context pool, query/gallery = evaluation).
# Hyper-parameters come from the Protocol-2 tuning fold (LOSS_ARGS / FINAL_ARGS / STEPS / SCHEDULE).
# Needs CUHK-SYSU. 12 trainings (more source data than Protocol-2: ~1.5-4 h each) + 12 evaluations.
# Can run together with stage4_protocol2.tasks (distinct task names), e.g.
#   python scripts/launch_tasks.py plans/stage4_protocol2.tasks --gpus 0,1,2,3
#   python scripts/launch_tasks.py plans/stage4_protocol3.tasks --gpus 4,5,6,7
# To save compute, the p3_s4_vicp_* / p3_s4e_vicp_* lines can be commented out (VICP ~ VPT so far).
p3_s4_vpt_market1501   | train p3_s4_vpt_market1501   $STEPS --model_type vpt   --source_domains $(p2_sources market1501) --source_all_images True --val_domains none --eval_strategy no --target_domains market1501 $LOSS_ARGS $FINAL_ARGS $SCHEDULE
p3_s4_vpt_msmt17       | train p3_s4_vpt_msmt17       $STEPS --model_type vpt   --source_domains $(p2_sources msmt17)     --source_all_images True --val_domains none --eval_strategy no --target_domains msmt17     $LOSS_ARGS $FINAL_ARGS $SCHEDULE
p3_s4_vpt_cuhksysu     | train p3_s4_vpt_cuhksysu     $STEPS --model_type vpt   --source_domains $(p2_sources cuhksysu)   --source_all_images True --val_domains none --eval_strategy no --target_domains cuhksysu   $LOSS_ARGS $FINAL_ARGS $SCHEDULE
p3_s4_vpt_cuhk03       | train p3_s4_vpt_cuhk03       $STEPS --model_type vpt   --source_domains $(p2_sources cuhk03)     --source_all_images True --val_domains none --eval_strategy no --target_domains cuhk03     $LOSS_ARGS $FINAL_ARGS $SCHEDULE
p3_s4_vicp_market1501  | train p3_s4_vicp_market1501  $STEPS --model_type vicp  --source_domains $(p2_sources market1501) --source_all_images True --val_domains none --eval_strategy no --target_domains market1501 $LOSS_ARGS $FINAL_ARGS $SCHEDULE
p3_s4_vicp_msmt17      | train p3_s4_vicp_msmt17      $STEPS --model_type vicp  --source_domains $(p2_sources msmt17)     --source_all_images True --val_domains none --eval_strategy no --target_domains msmt17     $LOSS_ARGS $FINAL_ARGS $SCHEDULE
p3_s4_vicp_cuhksysu    | train p3_s4_vicp_cuhksysu    $STEPS --model_type vicp  --source_domains $(p2_sources cuhksysu)   --source_all_images True --val_domains none --eval_strategy no --target_domains cuhksysu   $LOSS_ARGS $FINAL_ARGS $SCHEDULE
p3_s4_vicp_cuhk03      | train p3_s4_vicp_cuhk03      $STEPS --model_type vicp  --source_domains $(p2_sources cuhk03)     --source_all_images True --val_domains none --eval_strategy no --target_domains cuhk03     $LOSS_ARGS $FINAL_ARGS $SCHEDULE
p3_s4_full_market1501  | train p3_s4_full_market1501  $STEPS --model_type plain --source_domains $(p2_sources market1501) --source_all_images True --val_domains none --eval_strategy no --target_domains market1501 $LOSS_BOT $FULL_FT $SCHEDULE
p3_s4_full_msmt17      | train p3_s4_full_msmt17      $STEPS --model_type plain --source_domains $(p2_sources msmt17)     --source_all_images True --val_domains none --eval_strategy no --target_domains msmt17     $LOSS_BOT $FULL_FT $SCHEDULE
p3_s4_full_cuhksysu    | train p3_s4_full_cuhksysu    $STEPS --model_type plain --source_domains $(p2_sources cuhksysu)   --source_all_images True --val_domains none --eval_strategy no --target_domains cuhksysu   $LOSS_BOT $FULL_FT $SCHEDULE
p3_s4_full_cuhk03      | train p3_s4_full_cuhk03      $STEPS --model_type plain --source_domains $(p2_sources cuhk03)     --source_all_images True --val_domains none --eval_strategy no --target_domains cuhk03     $LOSS_BOT $FULL_FT $SCHEDULE
@wait
# evaluation: VICP with k = 4 / 16 annotated anchors x 3 context seeds; VPT / plain ignore the context
p3_s4e_vpt_market1501  | evaluate p3_s4e_vpt_market1501  experiments/p3_s4_vpt_market1501/checkpoint-$STEPS  --domains market1501 --target_domains market1501 --methods random --ks 16 --eval_seeds 1 --selection_unit image
p3_s4e_vpt_msmt17      | evaluate p3_s4e_vpt_msmt17      experiments/p3_s4_vpt_msmt17/checkpoint-$STEPS      --domains msmt17     --target_domains msmt17     --methods random --ks 16 --eval_seeds 1 --selection_unit image
p3_s4e_vpt_cuhksysu    | evaluate p3_s4e_vpt_cuhksysu    experiments/p3_s4_vpt_cuhksysu/checkpoint-$STEPS    --domains cuhksysu   --target_domains cuhksysu   --methods random --ks 16 --eval_seeds 1 --selection_unit image
p3_s4e_vpt_cuhk03      | evaluate p3_s4e_vpt_cuhk03      experiments/p3_s4_vpt_cuhk03/checkpoint-$STEPS      --domains cuhk03     --target_domains cuhk03     --methods random --ks 16 --eval_seeds 1 --selection_unit image
p3_s4e_vicp_market1501 | evaluate p3_s4e_vicp_market1501 experiments/p3_s4_vicp_market1501/checkpoint-$STEPS --domains market1501 --target_domains market1501 --methods random --ks 4,16 --eval_seeds 3 --selection_unit image
p3_s4e_vicp_msmt17     | evaluate p3_s4e_vicp_msmt17     experiments/p3_s4_vicp_msmt17/checkpoint-$STEPS     --domains msmt17     --target_domains msmt17     --methods random --ks 4,16 --eval_seeds 3 --selection_unit image
p3_s4e_vicp_cuhksysu   | evaluate p3_s4e_vicp_cuhksysu   experiments/p3_s4_vicp_cuhksysu/checkpoint-$STEPS   --domains cuhksysu   --target_domains cuhksysu   --methods random --ks 4,16 --eval_seeds 3 --selection_unit image
p3_s4e_vicp_cuhk03     | evaluate p3_s4e_vicp_cuhk03     experiments/p3_s4_vicp_cuhk03/checkpoint-$STEPS     --domains cuhk03     --target_domains cuhk03     --methods random --ks 4,16 --eval_seeds 3 --selection_unit image
p3_s4e_full_market1501 | evaluate p3_s4e_full_market1501 experiments/p3_s4_full_market1501/checkpoint-$STEPS --domains market1501 --target_domains market1501 --methods random --ks 16 --eval_seeds 1 --selection_unit image
p3_s4e_full_msmt17     | evaluate p3_s4e_full_msmt17     experiments/p3_s4_full_msmt17/checkpoint-$STEPS     --domains msmt17     --target_domains msmt17     --methods random --ks 16 --eval_seeds 1 --selection_unit image
p3_s4e_full_cuhksysu   | evaluate p3_s4e_full_cuhksysu   experiments/p3_s4_full_cuhksysu/checkpoint-$STEPS   --domains cuhksysu   --target_domains cuhksysu   --methods random --ks 16 --eval_seeds 1 --selection_unit image
p3_s4e_full_cuhk03     | evaluate p3_s4e_full_cuhk03     experiments/p3_s4_full_cuhk03/checkpoint-$STEPS     --domains cuhk03     --target_domains cuhk03     --methods random --ks 16 --eval_seeds 1 --selection_unit image
