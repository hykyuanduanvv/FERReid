# 10-06: CLIP MSMT17 fold at stage-1 lr 2e-4 (tuning fold: 2e-4 > 1e-4), then none / oracle (seed 0)
clip2_md_msmt17 | gpu_wait && train clip2_md_msmt17 $STEPS $MD $CLIP $(fold msmt17) $LOSS_ARGS $SCHEDULE --learning_rate 2e-4
c62_none_msmt_s0   after=clip2_md_msmt17 | gpu_wait && active c62_none_msmt_s0   $(ckpt clip2_md_msmt17) --domains msmt17 --strategies none   --n_seeds 1 --base_seed 0 $REP
c62_oracle_msmt_s0 after=clip2_md_msmt17 | gpu_wait && active c62_oracle_msmt_s0 $(ckpt clip2_md_msmt17) --domains msmt17 --strategies oracle --n_seeds 1 --base_seed 0 $REP
