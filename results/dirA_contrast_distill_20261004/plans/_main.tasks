# generated 2026-10-04: primary trainings + c0 cgains, then s43 extras; @wait; all cgains
c1_ctr_s42       | train c1_ctr_s42       300 $TUNE_DATA $C_BASE $CTR --seed 42
c1_ctr_s43       | train c1_ctr_s43       300 $TUNE_DATA $C_BASE $CTR --seed 43
c2_m10_s42       | train c2_m10_s42       300 $TUNE_DATA $C_BASE --ctx_contrast_weight 1.0 --ctx_contrast_margin 0.1 --seed 42
