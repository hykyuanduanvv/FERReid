c4_ema_s42       | train c4_ema_s42       300 $TUNE_DATA $C_BASE $CTR --ctx_center ema --seed 42
c5_cam_s42       | train c5_cam_s42       300 $TUNE_DATA $C_BASE $CTR --pseudo_domains camera_pair --pseudo_min_ids 64 --seed 42
c6_lora_det_s42  | train c6_lora_det_s42  300 $TUNE_DATA $C_BASE $CTR --train_context_only False --ctx_contrast_detach_encoder True --seed 42
c7_lora_raw_s42  | train c7_lora_raw_s42  300 $TUNE_DATA $C_BASE $CTR --train_context_only False --seed 42
g_c0_s42 | cgain g_c0_s42 experiments/c0_base_s42/checkpoint-300
g_c0_s43 | cgain g_c0_s43 experiments/c0_base_s43/checkpoint-300
c2_m10_s43       | train c2_m10_s43       300 $TUNE_DATA $C_BASE --ctx_contrast_weight 1.0 --ctx_contrast_margin 0.1 --seed 43
c3_w3_s43        | train c3_w3_s43        300 $TUNE_DATA $C_BASE --ctx_contrast_weight 3.0 --ctx_contrast_margin 0.05 --seed 43
c4_ema_s43       | train c4_ema_s43       300 $TUNE_DATA $C_BASE $CTR --ctx_center ema --seed 43
c5_cam_s43       | train c5_cam_s43       300 $TUNE_DATA $C_BASE $CTR --pseudo_domains camera_pair --pseudo_min_ids 64 --seed 43
c6_lora_det_s43  | train c6_lora_det_s43  300 $TUNE_DATA $C_BASE $CTR --train_context_only False --ctx_contrast_detach_encoder True --seed 43
c7_lora_raw_s43  | train c7_lora_raw_s43  300 $TUNE_DATA $C_BASE $CTR --train_context_only False --seed 43
@wait
